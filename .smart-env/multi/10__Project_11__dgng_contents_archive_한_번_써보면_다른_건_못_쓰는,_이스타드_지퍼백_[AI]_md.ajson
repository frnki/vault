:[54,57],"#한 번 써보면 다른 건 못 쓰는, 이스타드 지퍼백#두껍고 짱짱한 재질로 다시 사용하기 좋게#{1}":[56,57],"#한 번 써보면 다른 건 못 쓰는, 이스타드 지퍼백#함께 사용하면 좋은 제품: 글룀스타 흡착식 비닐봉투 정리대":[58,63],"#한 번 써보면 다른 건 못 쓰는, 이스타드 지퍼백#함께 사용하면 좋은 제품: 글룀스타 흡착식 비닐봉투 정리대#{1}":[60,63],"#한 번 써보면 다른 건 못 쓰는, 이스타드 지퍼백#마치며":[64,69],"#한 번 써보면 다른 건 못 쓰는, 이스타드 지퍼백#마치며#{1}":[66,69]},"outlinks":[{"title":"image","target":"https://content.dgng.co/wp-content/uploads/2020/09/istad_thumbnail-copy-1024x512.png","line":30,"embedded":true},{"title":"image","target":"https://content.dgng.co/wp-content/uploads/2020/09/istad_thumbnail-copy-2-1024x486.png","line":38,"embedded":true},{"title":"image","target":"http://content.dgng.co/wp-content/uploads/2020/09/스크린샷-2020-10-01-오전-12.03.07-1024x1024.png","line":50,"embedded":true},{"title":"image","target":"https://content.dgng.co/wp-content/uploads/2020/09/gloemsta-plastic-bag-holder-with-suction-cup__0869422_PE649236_S5-1024x1024.jpeg","line":60,"embedded":true},{"title":"쿠팡에서 구매하기","target":"https://coupa.ng/bKE9Dc","line":68}],"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"ztywid","at":1770127063307},"key":"10. Project/11. dgng/contents/archive/한 번 써보면 다른 건 못 쓰는, 이스타드 지퍼백 [AI].md"},
